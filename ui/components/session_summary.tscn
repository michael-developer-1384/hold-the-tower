[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/session_summary.gd" id="1"]

[node name="SessionSummary" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Col" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
text = "ACTIVE SESSION"
theme_override_font_sizes/font_size = 12

[node name="BodyLabel" type="Label" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
text = "Level · Difficulty · Wave"
theme_override_font_sizes/font_size = 15

[node name="ExtraLabel" type="Label" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
visible = false
text = ""
theme_override_font_sizes/font_size = 11

[node name="ActionsHost" type="HBoxContainer" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
