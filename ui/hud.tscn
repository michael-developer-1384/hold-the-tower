[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_script"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Root" type="MarginContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = 120.0
grow_horizontal = 2

[node name="VBox" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="TitleLabel" type="Label" parent="Root/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "HOLD THE TOWER"

[node name="CoreLabel" type="Label" parent="Root/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Core: 20"

[node name="EnemyLabel" type="Label" parent="Root/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Enemies: 0"

[node name="HintLabel" type="Label" parent="Root/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 14
text = "Q / E – Rotate"
